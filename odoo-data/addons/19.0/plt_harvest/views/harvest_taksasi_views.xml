<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Taksasi List View ───────────────────────────── -->
    <record id="view_harvest_taksasi_list" model="ir.ui.view">
        <field name="name">harvest.taksasi.list</field>
        <field name="model">harvest.taksasi</field>
        <field name="arch" type="xml">
            <list string="Taksasi">
                <field name="date"/>
                <field name="block_id"/>
                <field name="section"/>
                <field name="pokok_sampled"/>
                <field name="bunches_counted"/>
                <field name="AKP"/>
                <field name="estimated_janjang"/>
                <field name="estimated_tonnage"/>
                <field name="required_harvesters"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <!-- ── Taksasi Form View ───────────────────────────── -->
    <record id="view_harvest_taksasi_form" model="ir.ui.view">
        <field name="priority">1</field>
        <field name="name">harvest.taksasi.form</field>
        <field name="model">harvest.taksasi</field>
        <field name="arch" type="xml">
            <form string="Taksasi">
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_draft" type="object"
                            string="Set Draft"
                            invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="block_id"/>
                            <field name="section"/>
                        </group>
                        <group>
                            <field name="pokok_sampled"/>
                            <field name="bunches_counted"/>
                            <field name="AKP"/>
                        </group>
                    </group>
                    <group string="Estimates">
                        <group>
                            <field name="estimated_janjang"/>
                            <field name="estimated_tonnage"/>
                        </group>
                        <group>
                            <field name="required_harvesters"/>
                            <field name="required_trucks"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── Taksasi Action ──────────────────────────────── -->
    <record id="action_harvest_taksasi" model="ir.actions.act_window">
        <field name="name">Taksasi</field>
        <field name="res_model">harvest.taksasi</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
