<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Inspection List View ─────────────────────────── -->
    <record id="view_harvest_inspection_list" model="ir.ui.view">
        <field name="name">harvest.inspection.list</field>
        <field name="model">harvest.inspection</field>
        <field name="arch" type="xml">
            <list string="Mutu Inspeksi">
                <field name="date"/>
                <field name="inspection_type"/>
                <field name="mandor_id"/>
                <field name="block_id"/>
                <field name="total_score"/>
                <field name="result" widget="badge"
                       decoration-success="result == 'pass'"
                       decoration-danger="result == 'fail'"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'posted'"/>
            </list>
        </field>
    </record>

    <!-- ── Inspection Form View ─────────────────────────── -->
    <record id="view_harvest_inspection_form" model="ir.ui.view">
        <field name="priority">1</field>
        <field name="name">harvest.inspection.form</field>
        <field name="model">harvest.inspection</field>
        <field name="arch" type="xml">
            <form string="Mutu Inspeksi">
                <header>
                    <button name="action_post" type="object"
                            string="Post" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_draft" type="object"
                            string="Set Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="inspection_type"/>
                            <field name="mandor_id"/>
                            <field name="block_id"/>
                        </group>
                        <group>
                            <field name="total_score"/>
                            <field name="result"/>
                        </group>
                    </group>
                    <group string="Item Checklist">
                        <field name="checklist_items"/>
                    </group>
                    <group string="Skor Komponen">
                        <group>
                            <field name="score_buah_mentah"/>
                            <field name="score_tangkai_panjang"/>
                            <field name="score_brondolan"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── Inspection Search View ──────────────────────── -->
    <record id="view_harvest_inspection_search" model="ir.ui.view">
        <field name="name">harvest.inspection.search</field>
        <field name="model">harvest.inspection</field>
        <field name="arch" type="xml">
            <search string="Cari Inspeksi">
                <field name="date"/>
                <field name="mandor_id"/>
                <field name="block_id"/>
                <filter name="draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="posted" string="Posted"
                        domain="[('state', '=', 'posted')]"/>
                <filter name="pass" string="Lulus"
                        domain="[('result', '=', 'pass')]"/>
                <filter name="fail" string="Gagal"
                        domain="[('result', '=', 'fail')]"/>
            </search>
        </field>
    </record>

    <!-- ── Inspection Action ────────────────────────────── -->
    <record id="action_harvest_inspection" model="ir.actions.act_window">
        <field name="name">Mutu Inspeksi</field>
        <field name="res_model">harvest.inspection</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>