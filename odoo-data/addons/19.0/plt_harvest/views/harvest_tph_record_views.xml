<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── TPH Record List View ────────────────────────── -->
    <record id="view_harvest_tph_record_list" model="ir.ui.view">
        <field name="name">harvest.tph_record.list</field>
        <field name="model">harvest.tph_record</field>
        <field name="arch" type="xml">
            <list string="TPH Records">
                <field name="date"/>
                <field name="tph_id"/>
                <field name="harvester_id"/>
                <field name="kerani_id"/>
                <field name="janjang_count"/>
                <field name="brondolan_kg"/>
                <field name="BJR"/>
                <field name="total_tonnage"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <!-- ── TPH Record Form View ────────────────────────── -->
    <record id="view_harvest_tph_record_form" model="ir.ui.view">
        <field name="priority">99</field>
        <field name="name">harvest.tph_record.form</field>
        <field name="model">harvest.tph_record</field>
        <field name="arch" type="xml">
            <form string="TPH Record">
                <header>
                    <button name="action_submit" type="object"
                            string="Submit" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_verify" type="object"
                            string="Verify"
                            invisible="state != 'submitted'"/>
                    <button name="action_approve" type="object"
                            string="Approve"
                            invisible="state != 'verified'"/>
                    <button name="action_draft" type="object"
                            string="Set Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,verified,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="tph_id"/>
                            <field name="harvester_id"/>
                            <field name="kerani_id"/>
                        </group>
                        <group>
                            <field name="timestamp"/>
                            <field name="gps_lat"/>
                            <field name="gps_lon"/>
                        </group>
                    </group>
                    <group string="Harvest Quantities">
                        <group>
                            <field name="janjang_count"/>
                            <field name="brondolan_kg"/>
                            <field name="brondolan_karung"/>
                        </group>
                        <group>
                            <field name="BJR"/>
                            <field name="total_tonnage"/>
                        </group>
                    </group>
                    <group string="Photo">
                        <field name="photo" widget="image"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── TPH Record Action ───────────────────────────── -->
    <record id="action_harvest_tph_record" model="ir.actions.act_window">
        <field name="name">TPH Records</field>
        <field name="res_model">harvest.tph_record</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
