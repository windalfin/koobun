<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Denda Config List View ──────────────────────── -->
    <record id="view_harvest_denda_config_list" model="ir.ui.view">
        <field name="name">harvest.denda_config.list</field>
        <field name="model">harvest.denda_config</field>
        <field name="arch" type="xml">
            <list string="Denda Config">
                <field name="event_type" widget="badge"/>
                <field name="rate_per_unit"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <!-- ── Denda Config Form View ──────────────────────── -->
    <record id="view_harvest_denda_config_form" model="ir.ui.view">
        <field name="priority">1</field>
        <field name="name">harvest.denda_config.form</field>
        <field name="model">harvest.denda_config</field>
        <field name="arch" type="xml">
            <form string="Denda Config">
                <header>
                    <button name="action_approve" type="object"
                            string="Approve" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_draft" type="object"
                            string="Set Draft"
                            invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="event_type"/>
                            <field name="rate_per_unit"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── Denda Config Action ─────────────────────────── -->
    <record id="action_harvest_denda_config" model="ir.actions.act_window">
        <field name="name">Denda Config</field>
        <field name="res_model">harvest.denda_config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
