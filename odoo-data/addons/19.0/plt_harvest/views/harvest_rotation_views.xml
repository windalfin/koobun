<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Rotation List View ──────────────────────────── -->
    <record id="view_harvest_rotation_list" model="ir.ui.view">
        <field name="name">harvest.rotation.list</field>
        <field name="model">harvest.rotation</field>
        <field name="arch" type="xml">
            <list string="Rotations">
                <field name="name"/>
                <field name="rotation_interval_days"/>
                <field name="last_harvest_date"/>
                <field name="next_harvest_date"/>
                <field name="block_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- ── Rotation Form View ──────────────────────────── -->
    <record id="view_harvest_rotation_form" model="ir.ui.view">
        <field name="priority">1</field>
        <field name="name">harvest.rotation.form</field>
        <field name="model">harvest.rotation</field>
        <field name="arch" type="xml">
            <form string="Rotation">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="rotation_interval_days"/>
                        </group>
                        <group>
                            <field name="last_harvest_date"/>
                            <field name="next_harvest_date"/>
                        </group>
                    </group>
                    <group string="Blocks">
                        <field name="block_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── Rotation Action ─────────────────────────────── -->
    <record id="action_harvest_rotation" model="ir.actions.act_window">
        <field name="name">Rotations</field>
        <field name="res_model">harvest.rotation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
