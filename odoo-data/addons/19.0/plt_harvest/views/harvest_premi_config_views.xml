<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Premi Config List View ──────────────────────── -->
    <record id="view_harvest_premi_config_list" model="ir.ui.view">
        <field name="name">harvest.premi_config.list</field>
        <field name="model">harvest.premi_config</field>
        <field name="arch" type="xml">
            <list string="Premi Config">
                <field name="name"/>
                <field name="block_class"/>
                <field name="basis_kg_per_hk"/>
                <field name="premi_tier_1_rate"/>
                <field name="premi_tier_2_rate"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <!-- ── Premi Config Form View ──────────────────────── -->
    <record id="view_harvest_premi_config_form" model="ir.ui.view">
        <field name="name">harvest.premi_config.form</field>
        <field name="model">harvest.premi_config</field>
        <field name="arch" type="xml">
            <form string="Premi Config">
                <header>
                    <button name="action_approve" type="object"
                            string="Approve" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_draft" type="object"
                            string="Set Draft"
                            invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="block_class"/>
                            <field name="tahun_tanam_min"/>
                            <field name="tahun_tanam_max"/>
                        </group>
                    </group>
                    <group string="Rates">
                        <group>
                            <field name="basis_kg_per_hk"/>
                            <field name="premi_tier_1_rate"/>
                            <field name="premi_tier_2_rate"/>
                            <field name="premi_tier_1_threshold"/>
                        </group>
                        <group>
                            <field name="brondolan_rate"/>
                            <field name="mandor_multiplier"/>
                            <field name="kerani_multiplier"/>
                        </group>
                    </group>
                    <group string="Validity">
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── Premi Config Action ─────────────────────────── -->
    <record id="action_harvest_premi_config" model="ir.actions.act_window">
        <field name="name">Premi Config</field>
        <field name="res_model">harvest.premi_config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
