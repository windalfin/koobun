<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Quality Event List View ─────────────────────── -->
    <record id="view_harvest_quality_event_list" model="ir.ui.view">
        <field name="name">harvest.quality_event.list</field>
        <field name="model">harvest.quality_event</field>
        <field name="arch" type="xml">
            <list string="Quality Events">
                <field name="tph_record_id"/>
                <field name="event_type" widget="badge"/>
                <field name="quantity"/>
                <field name="rate"/>
                <field name="denda_amount"/>
            </list>
        </field>
    </record>

    <!-- ── Quality Event Form View ─────────────────────── -->
    <record id="view_harvest_quality_event_form" model="ir.ui.view">
        <field name="priority">99</field>
        <field name="name">harvest.quality_event.form</field>
        <field name="model">harvest.quality_event</field>
        <field name="arch" type="xml">
            <form string="Quality Event">
                <sheet>
                    <group>
                        <group>
                            <field name="tph_record_id"/>
                            <field name="event_type"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="rate"/>
                            <field name="denda_amount"/>
                        </group>
                    </group>
                    <group string="Photo">
                        <field name="photo" widget="image"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── Quality Event Action ────────────────────────── -->
    <record id="action_harvest_quality_event" model="ir.actions.act_window">
        <field name="name">Quality Events</field>
        <field name="res_model">harvest.quality_event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
