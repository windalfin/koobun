<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Harvest User Group ───────────────────────────────── -->
    <record id="group_harvest_user" model="res.groups">
        <field name="name">Harvest User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Access to daily harvest operations: taksasi, ancak, TPH capture.</field>
    </record>

    <!-- ── Harvest Manager Group ────────────────────────────── -->
    <record id="group_harvest_manager" model="res.groups">
        <field name="name">Harvest Manager</field>
        <field name="implied_ids" eval="[(4, ref('plt_harvest.group_harvest_user'))]"/>
        <field name="comment">Full CRUD access to all harvest management data including premi/denda config.</field>
    </record>

    <!-- ── Record Rules ─────────────────────────────────────── -->

    <!-- Taksasi: read all -->
    <record id="rule_taksasi_read_all" model="ir.rule">
        <field name="name">Taksasi: read all</field>
        <field name="model_id" ref="model_harvest_taksasi"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Rotation: read all -->
    <record id="rule_rotation_read_all" model="ir.rule">
        <field name="name">Rotation: read all</field>
        <field name="model_id" ref="model_harvest_rotation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Ancak: read all -->
    <record id="rule_ancak_read_all" model="ir.rule">
        <field name="name">Ancak: read all</field>
        <field name="model_id" ref="model_harvest_ancak"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- TPH Record: read all -->
    <record id="rule_tph_record_read_all" model="ir.rule">
        <field name="name">TPH Record: read all</field>
        <field name="model_id" ref="model_harvest_tph_record"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Quality Event: read all -->
    <record id="rule_quality_event_read_all" model="ir.rule">
        <field name="name">Quality Event: read all</field>
        <field name="model_id" ref="model_harvest_quality_event"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Premi Config: read all -->
    <record id="rule_premi_config_read_all" model="ir.rule">
        <field name="name">Premi Config: read all</field>
        <field name="model_id" ref="model_harvest_premi_config"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Denda Config: read all -->
    <record id="rule_denda_config_read_all" model="ir.rule">
        <field name="name">Denda Config: read all</field>
        <field name="model_id" ref="model_harvest_denda_config"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Inspection: read all -->
    <record id="rule_inspection_read_all" model="ir.rule">
        <field name="name">Inspection: read all</field>
        <field name="model_id" ref="model_harvest_inspection"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Premi Statement: read all -->
    <record id="rule_premi_statement_read_all" model="ir.rule">
        <field name="name">Premi Statement: read all</field>
        <field name="model_id" ref="model_harvest_premi_statement"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- ── Auto-assign admin to manager groups ───────────────── -->
    <record id="group_harvest_manager" model="res.groups">
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_harvest_user" model="res.groups">
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

</odoo>
