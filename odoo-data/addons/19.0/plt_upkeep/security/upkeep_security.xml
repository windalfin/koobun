<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_upkeep_manager" model="res.groups">
        <field name="name">Upkeep Manager</field>
        <field name="comment">Full CRUD access to upkeep operations.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- ── Auto-assign admin to manager group ────────────────── -->
    <record id="group_upkeep_manager" model="res.groups">
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

</odoo>
