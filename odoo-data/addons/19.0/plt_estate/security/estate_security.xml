<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Estate Manager Group ─────────────────────────────── -->
    <record id="group_estate_manager" model="res.groups">
        <field name="name">Estate Manager</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Full CRUD access to all estate master data.</field>
    </record>

    <!-- ── Estate Admin Group ───────────────────────────────── -->
    <record id="group_estate_admin" model="res.groups">
        <field name="name">Estate Administrator</field>
        <field name="implied_ids" eval="[(4, ref('plt_estate.group_estate_manager'))]"/>
        <field name="comment">Admin-level access including configuration and approval.</field>
    </record>

    <!-- ── Record Rules ─────────────────────────────────────── -->

    <!-- Estate: read all -->
    <record id="estate_estate_read_all" model="ir.rule">
        <field name="name">Estate: read all</field>
        <field name="model_id" ref="model_estate_estate"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Afdeling: read all -->
    <record id="estate_afdeling_read_all" model="ir.rule">
        <field name="name">Afdeling: read all</field>
        <field name="model_id" ref="model_estate_afdeling"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Block: scope by afdeling for managers -->
    <record id="estate_block_read_all" model="ir.rule">
        <field name="name">Block: read all</field>
        <field name="model_id" ref="model_estate_block"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Census: read all -->
    <record id="estate_census_read_all" model="ir.rule">
        <field name="name">Census: read all</field>
        <field name="model_id" ref="model_estate_census"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Land Document: read all -->
    <record id="estate_land_document_read_all" model="ir.rule">
        <field name="name">Land Document: read all</field>
        <field name="model_id" ref="model_estate_land_document"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Ancak: read all -->
    <record id="estate_ancak_read_all" model="ir.rule">
        <field name="name">Ancak: read all</field>
        <field name="model_id" ref="model_estate_ancak"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- TPH: read all -->
    <record id="estate_tph_read_all" model="ir.rule">
        <field name="name">TPH: read all</field>
        <field name="model_id" ref="model_estate_tph"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
