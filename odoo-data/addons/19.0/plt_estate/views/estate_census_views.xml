<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Census Tree View ──────────────────────────────── -->
    <record id="view_estate_census_tree" model="ir.ui.view">
        <field name="name">estate.census.tree</field>
        <field name="model">estate.census</field>
        <field name="arch" type="xml">
            <list string="Census Records">
                <field name="date"/>
                <field name="block_id"/>
                <field name="total_pokok"/>
                <field name="productive_count"/>
                <field name="unproductive_count"/>
                <field name="dead_count"/>
                <field name="vacant_points"/>
                <field name="sisipan_count"/>
                <field name="var_total" string="Δ Total"/>
            </list>
        </field>
    </record>

    <!-- ── Census Form View ──────────────────────────────── -->
    <record id="view_estate_census_form" model="ir.ui.view">
        <field name="name">estate.census.form</field>
        <field name="model">estate.census</field>
        <field name="arch" type="xml">
            <form string="Census">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="block_id"/>
                            <field name="previous_census_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Counts">
                            <group>
                                <group>
                                    <field name="productive_count"/>
                                    <field name="unproductive_count"/>
                                    <field name="dead_count"/>
                                </group>
                                <group>
                                    <field name="vacant_points"/>
                                    <field name="sisipan_count"/>
                                    <field name="total_pokok"/>
                                </group>
                            </group>
                        </page>
                        <page string="Variance">
                            <group>
                                <group>
                                    <field name="var_productive"/>
                                    <field name="var_unproductive"/>
                                    <field name="var_dead"/>
                                </group>
                                <group>
                                    <field name="var_vacant"/>
                                    <field name="var_sisipan"/>
                                    <field name="var_total"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── Census Action ─────────────────────────────────── -->
    <record id="action_estate_census" model="ir.actions.act_window">
        <field name="name">Census</field>
        <field name="res_model">estate.census</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first census record!
            </p>
        </field>
    </record>
</odoo>
