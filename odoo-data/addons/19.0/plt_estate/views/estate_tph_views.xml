<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── TPH Tree View ─────────────────────────────────── -->
    <record id="view_estate_tph_tree" model="ir.ui.view">
        <field name="name">estate.tph.tree</field>
        <field name="model">estate.tph</field>
        <field name="arch" type="xml">
            <list string="TPHs">
                <field name="name"/>
                <field name="code"/>
                <field name="block_id"/>
                <field name="gps_lat"/>
                <field name="gps_lon"/>
            </list>
        </field>
    </record>

    <!-- ── TPH Form View ─────────────────────────────────── -->
    <record id="view_estate_tph_form" model="ir.ui.view">
        <field name="priority">99</field>
        <field name="name">estate.tph.form</field>
        <field name="model">estate.tph</field>
        <field name="arch" type="xml">
            <form string="TPH">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="block_id"/>
                        </group>
                        <group>
                            <field name="gps_lat"/>
                            <field name="gps_lon"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── TPH Action ────────────────────────────────────── -->
    <record id="action_estate_tph" model="ir.actions.act_window">
        <field name="name">TPHs</field>
        <field name="res_model">estate.tph</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
