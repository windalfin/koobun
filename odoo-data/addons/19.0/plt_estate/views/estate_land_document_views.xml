<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Land Document Tree View ───────────────────────── -->
    <record id="view_estate_land_document_tree" model="ir.ui.view">
        <field name="name">estate.land.document.tree</field>
        <field name="model">estate.land.document</field>
        <field name="arch" type="xml">
            <list string="Land Documents"
                  decoration-danger="expiry_alert in ('30days', 'expired')"
                  decoration-warning="expiry_alert in ('60days', '90days')">
                <field name="name"/>
                <field name="document_type"/>
                <field name="number"/>
                <field name="holder_name"/>
                <field name="area_ha"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="days_to_expiry"/>
                <field name="expiry_alert" widget="badge"
                       decoration-danger="expiry_alert in ('30days', 'expired')"
                       decoration-warning="expiry_alert in ('60days', '90days')"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- ── Land Document Form View ───────────────────────── -->
    <record id="view_estate_land_document_form" model="ir.ui.view">
        <field name="priority">99</field>
        <field name="name">estate.land.document.form</field>
        <field name="model">estate.land.document</field>
        <field name="arch" type="xml">
            <form string="Land Document">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                         invisible="expiry_alert not in ('30days', 'expired')">
                        <strong>⚠ Expiry Warning:</strong>
                        This document
                        <span invisible="expiry_alert != 'expired'">
                            has expired!
                        </span>
                        <span invisible="expiry_alert != '30days'">
                            expires within 30 days!
                        </span>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="document_type"/>
                            <field name="number"/>
                            <field name="holder_name"/>
                        </group>
                        <group>
                            <field name="area_ha"/>
                            <field name="location"/>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="days_to_expiry"/>
                            <field name="expiry_alert"
                                   invisible="True"/>
                        </group>
                    </group>
                    <group string="Related Blocks">
                        <field name="block_ids" nolabel="1"
                               widget="many2many_tags"/>
                    </group>
                    <group string="Attachments">
                        <field name="attachment_ids" nolabel="1"
                               widget="many2many_binary"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── Land Document Action ──────────────────────────── -->
    <record id="action_estate_land_document" model="ir.actions.act_window">
        <field name="name">Land Documents</field>
        <field name="res_model">estate.land.document</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register the first land document!
            </p>
        </field>
    </record>
</odoo>
