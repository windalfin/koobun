<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Ancak Tree View ───────────────────────────────── -->
    <record id="view_estate_ancak_tree" model="ir.ui.view">
        <field name="name">estate.ancak.tree</field>
        <field name="model">estate.ancak</field>
        <field name="arch" type="xml">
            <list string="Ancak">
                <field name="name"/>
                <field name="code"/>
                <field name="block_id"/>
                <field name="area_ha"/>
            </list>
        </field>
    </record>

    <!-- ── Ancak Form View ───────────────────────────────── -->
    <record id="view_estate_ancak_form" model="ir.ui.view">
        <field name="priority">99</field>
        <field name="name">estate.ancak.form</field>
        <field name="model">estate.ancak</field>
        <field name="arch" type="xml">
            <form string="Ancak">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="block_id"/>
                            <field name="area_ha"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Ancak Action ──────────────────────────────────── -->
    <record id="action_estate_ancak" model="ir.actions.act_window">
        <field name="name">Ancak</field>
        <field name="res_model">estate.ancak</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
