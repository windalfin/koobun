<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        PLT-01 Estate Master Data — Reference & Configuration Data

        This file contains default configuration values for the plantation
        estate module. Values can be overridden by creating new
        ir.config_parameter records.
    -->

    <!-- Default SPH (Stand per Hectare) for oil palm -->
    <record id="default_sph" model="ir.config_parameter">
        <field name="key">plt_estate.default_sph</field>
        <field name="value">143</field>
    </record>

    <!-- Default planting density lookup -->
    <record id="default_planting_density" model="ir.config_parameter">
        <field name="key">plt_estate.default_planting_density</field>
        <field name="value">143</field>
    </record>

    <!-- Soil classification: supported values -->
    <record id="soil_class_list" model="ir.config_parameter">
        <field name="key">plt_estate.soil_classes</field>
        <field name="value">mineral,gambut,pasir,liat</field>
    </record>

    <!-- Topography classification: supported values -->
    <record id="topography_class_list" model="ir.config_parameter">
        <field name="key">plt_estate.topography_classes</field>
        <field name="value">datar,bergelombang,berbukit,curam</field>
    </record>

    <!-- Document types -->
    <record id="document_type_list" model="ir.config_parameter">
        <field name="key">plt_estate.document_types</field>
        <field name="value">shm,hgu,stdb,iup,izin_lingkungan,lainnya</field>
    </record>
</odoo>
