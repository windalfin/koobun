<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================ -->
    <!--  Mill Reception — Views                                           -->
    <!-- ================================================================ -->

    <!-- Tree View -->
    <record id="view_sales_mill_reception_tree" model="ir.ui.view">
        <field name="name">sales.mill_reception.tree</field>
        <field name="model">sales.mill_reception</field>
        <field name="arch" type="xml">
            <list string="Mill Receptions">
                <field name="spb_id"/>
                <field name="reception_date"/>
                <field name="gross_kg"/>
                <field name="sortasi_deduction_kg"/>
                <field name="sortasi_deduction_pct" optional="hide"/>
                <field name="accepted_net_kg"/>
                <field name="mill_doc_ref"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_sales_mill_reception_form" model="ir.ui.view">
        <field name="priority">1</field>
        <field name="name">sales.mill_reception.form</field>
        <field name="model">sales.mill_reception</field>
        <field name="arch" type="xml">
            <form string="Mill Reception">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="spb_id"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Weighbridge">
                            <field name="gross_kg" required="1"/>
                            <field name="reception_date" required="1"/>
                            <field name="mill_doc_ref"/>
                        </group>
                        <group string="Sortasi">
                            <field name="sortasi_deduction_kg"/>
                            <field name="sortasi_deduction_pct"/>
                            <field name="accepted_net_kg"/>
                        </group>
                    </group>
                    <group string="Deduction Details">
                        <field name="deduction_reasons"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_sales_mill_reception_search" model="ir.ui.view">
        <field name="name">sales.mill_reception.search</field>
        <field name="model">sales.mill_reception</field>
        <field name="arch" type="xml">
            <search string="Search Receptions">
                <field name="spb_id"/>
                <field name="mill_doc_ref"/>
                <field name="reception_date"/>
            </search>
        </field>
    </record>

</odoo>
