<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================ -->
    <!--  TBS Price Table — Views                                          -->
    <!-- ================================================================ -->

    <!-- Tree View -->
    <record id="view_sales_tbs_price_tree" model="ir.ui.view">
        <field name="name">sales.tbs_price.tree</field>
        <field name="model">sales.tbs_price</field>
        <field name="arch" type="xml">
            <list string="TBS Prices">
                <field name="name"/>
                <field name="price_type"/>
                <field name="age_band_min"/>
                <field name="age_band_max"/>
                <field name="rendemen_pct" optional="hide"/>
                <field name="indeks_k" optional="hide"/>
                <field name="price_per_kg"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_sales_tbs_price_form" model="ir.ui.view">
        <field name="priority">99</field>
        <field name="name">sales.tbs_price.form</field>
        <field name="model">sales.tbs_price</field>
        <field name="arch" type="xml">
            <form string="TBS Price">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_expire" type="object" string="Expire"
                            class="btn-secondary"
                            invisible="state != 'approved'"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Market Price July 2025"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Price Info">
                            <field name="price_type" required="1"/>
                            <field name="price_per_kg" required="1"/>
                            <field name="cp_oil_reference"/>
                        </group>
                        <group string="Age Band">
                            <field name="age_band_min" required="1"/>
                            <field name="age_band_max" required="1"/>
                            <field name="rendemen_pct"/>
                            <field name="indeks_k"/>
                        </group>
                    </group>
                    <group string="Validity">
                        <field name="date_from" required="1"/>
                        <field name="date_to" required="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_sales_tbs_price_search" model="ir.ui.view">
        <field name="name">sales.tbs_price.search</field>
        <field name="model">sales.tbs_price</field>
        <field name="arch" type="xml">
            <search string="Search TBS Prices">
                <field name="name"/>
                <field name="price_type"/>
                <field name="price_per_kg"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
            </search>
        </field>
    </record>

</odoo>
