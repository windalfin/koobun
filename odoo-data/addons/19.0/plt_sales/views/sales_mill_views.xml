<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================ -->
    <!--  Sales Mill / Customer Master — Views                             -->
    <!-- ================================================================ -->

    <!-- Tree View -->
    <record id="view_sales_mill_tree" model="ir.ui.view">
        <field name="name">sales.mill.tree</field>
        <field name="model">sales.mill</field>
        <field name="arch" type="xml">
            <list string="Mills / Customers">
                <field name="name"/>
                <field name="partner_id" optional="hide"/>
                <field name="pricing_basis"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_sales_mill_form" model="ir.ui.view">
        <field name="priority">1</field>
        <field name="name">sales.mill.form</field>
        <field name="model">sales.mill</field>
        <field name="arch" type="xml">
            <form string="Mill / Customer">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object"
                                class="oe_stat_button" icon="fa-archive"
                                invisible="not is_active">
                            <field name="is_active" widget="boolean_button"
                                   options='{"terminology": "active"}'/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            invisible="is_active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Customer Info">
                            <field name="partner_id" required="1"/>
                            <field name="pricing_basis" required="1"/>
                            <field name="is_active"/>
                        </group>
                        <group string="Rules &amp; Terms">
                            <field name="sortasi_rules"/>
                            <field name="payment_terms"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_sales_mill_search" model="ir.ui.view">
        <field name="name">sales.mill.search</field>
        <field name="model">sales.mill</field>
        <field name="arch" type="xml">
            <search string="Search Mills">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="pricing_basis"/>
                <filter name="active" string="Active" domain="[('is_active', '=', True)]"/>
                <filter name="inactive" string="Archived" domain="[('is_active', '=', False)]"/>
            </search>
        </field>
    </record>

</odoo>
