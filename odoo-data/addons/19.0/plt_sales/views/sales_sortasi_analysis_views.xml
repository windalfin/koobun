<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================ -->
    <!--  Sortasi Analysis — Views                                         -->
    <!-- ================================================================ -->

    <!-- Tree View -->
    <record id="view_sales_sortasi_analysis_tree" model="ir.ui.view">
        <field name="name">sales.sortasi_analysis.tree</field>
        <field name="model">sales.sortasi_analysis</field>
        <field name="arch" type="xml">
            <list string="Sortasi Analysis">
                <field name="mill_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="block_id" optional="hide"/>
                <field name="mandor_id" optional="hide"/>
                <field name="deduction_reason"/>
                <field name="total_deduction_kg"/>
                <field name="frequency_count"/>
                <field name="trend_pct"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_sales_sortasi_analysis_form" model="ir.ui.view">
        <field name="name">sales.sortasi_analysis.form</field>
        <field name="model">sales.sortasi_analysis</field>
        <field name="arch" type="xml">
            <form string="Sortasi Analysis">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="deduction_reason" placeholder="e.g. buah mentah"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Scope">
                            <field name="mill_id" required="1"/>
                            <field name="period_start" required="1"/>
                            <field name="period_end" required="1"/>
                        </group>
                        <group string="Drill-Down">
                            <field name="block_id"/>
                            <field name="mandor_id"/>
                        </group>
                    </group>
                    <group string="Analysis">
                        <field name="deduction_reason" required="1"/>
                        <field name="total_deduction_kg"/>
                        <field name="frequency_count"/>
                        <field name="trend_pct"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_sales_sortasi_analysis_search" model="ir.ui.view">
        <field name="name">sales.sortasi_analysis.search</field>
        <field name="model">sales.sortasi_analysis</field>
        <field name="arch" type="xml">
            <search string="Search Sortasi Analysis">
                <field name="mill_id"/>
                <field name="deduction_reason"/>
                <field name="period_start"/>
                <field name="block_id"/>
                <field name="mandor_id"/>
            </search>
        </field>
    </record>

</odoo>
