<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================ -->
    <!--  Sales Top-Level Menu + Actions                                   -->
    <!-- ================================================================ -->

    <menuitem id="menu_sales_root"
              name="Sales"
              sequence="70"
              web_icon="plt_sales,static/description/icon.png"/>

    <!-- Actions -->
    <record id="action_sales_mill" model="ir.actions.act_window">
        <field name="name">Mills / Customers</field>
        <field name="res_model">sales.mill</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sales_mill_search"/>
    </record>

    <record id="action_sales_tbs_price" model="ir.actions.act_window">
        <field name="name">TBS Prices</field>
        <field name="res_model">sales.tbs_price</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sales_tbs_price_search"/>
    </record>

    <record id="action_sales_mill_reception" model="ir.actions.act_window">
        <field name="name">Mill Receptions</field>
        <field name="res_model">sales.mill_reception</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sales_mill_reception_search"/>
    </record>

    <record id="action_sales_invoice" model="ir.actions.act_window">
        <field name="name">Sales Invoices</field>
        <field name="res_model">sales.invoice</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sales_invoice_search"/>
    </record>

    <record id="action_sales_sortasi_analysis" model="ir.actions.act_window">
        <field name="name">Sortasi Analysis</field>
        <field name="res_model">sales.sortasi_analysis</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sales_sortasi_analysis_search"/>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_sales_mill"
              parent="menu_sales_root"
              name="Mills / Customers"
              sequence="10"
              action="action_sales_mill"/>

    <menuitem id="menu_sales_tbs_price"
              parent="menu_sales_root"
              name="TBS Prices"
              sequence="20"
              action="action_sales_tbs_price"/>

    <menuitem id="menu_sales_mill_reception"
              parent="menu_sales_root"
              name="Mill Receptions"
              sequence="30"
              action="action_sales_mill_reception"/>

    <menuitem id="menu_sales_invoice"
              parent="menu_sales_root"
              name="Sales Invoices"
              sequence="40"
              action="action_sales_invoice"/>

    <menuitem id="menu_sales_sortasi_analysis"
              parent="menu_sales_root"
              name="Sortasi Analysis"
              sequence="50"
              action="action_sales_sortasi_analysis"/>

</odoo>
