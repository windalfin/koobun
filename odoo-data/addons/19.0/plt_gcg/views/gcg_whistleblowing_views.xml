<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================ -->
    <!--  Whistleblowing — Tree View                                       -->
    <!-- ================================================================ -->
    <record id="view_gcg_whistleblowing_tree" model="ir.ui.view">
        <field name="name">gcg.whistleblowing.tree</field>
        <field name="model">gcg.whistleblowing</field>
        <field name="arch" type="xml">
            <list string="Whistleblowing Cases">
                <field name="case_number"/>
                <field name="subject"/>
                <field name="channel" optional="show"/>
                <field name="status" widget="badge" decoration-success="status == 'resolved'" decoration-info="status == 'under_investigation'" decoration-muted="status == 'closed'"/>
                <field name="assigned_to" optional="show"/>
                <field name="is_anonymous" optional="show"/>
                <field name="create_date" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Whistleblowing — Form View -->
    <record id="view_gcg_whistleblowing_form" model="ir.ui.view">
        <field name="priority">99</field>
        <field name="name">gcg.whistleblowing.form</field>
        <field name="model">gcg.whistleblowing</field>
        <field name="arch" type="xml">
            <form string="Whistleblowing Case">
                <header>
                    <button name="action_investigate" string="Start Investigation"
                            type="object" invisible="status != 'submitted'" class="btn-primary"/>
                    <button name="action_resolve" string="Resolve"
                            type="object" invisible="status not in ('submitted', 'under_investigation')"
                            class="btn-success"/>
                    <button name="action_close" string="Close"
                            type="object" invisible="status not in ('submitted', 'under_investigation', 'resolved')"
                            class="btn-secondary"/>
                    <field name="status" widget="statusbar"
                           options="{'clickable': '0'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="case_number" readonly="1"/>
                            <span> — </span>
                            <field name="subject" placeholder="Case subject..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Reporter">
                            <field name="channel"/>
                            <field name="is_anonymous"/>
                            <field name="reporter_name"
                                   invisible="is_anonymous"/>
                            <field name="reporter_email"
                                   invisible="is_anonymous"/>
                        </group>
                        <group string="Case Management">
                            <field name="assigned_to"/>
                            <field name="resolution_date"/>
                        </group>
                    </group>
                    <group string="Details">
                        <field name="description" nolabel="1"
                               placeholder="Describe the concern in detail..."/>
                    </group>
                    <group string="Resolution">
                        <field name="resolution" nolabel="1"
                               placeholder="Document the resolution..."/>
                    </group>
                    <group string="Attachments">
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Whistleblowing — Search View -->
    <record id="view_gcg_whistleblowing_search" model="ir.ui.view">
        <field name="name">gcg.whistleblowing.search</field>
        <field name="model">gcg.whistleblowing</field>
        <field name="arch" type="xml">
            <search string="Search Cases">
                <field name="case_number"/>
                <field name="subject"/>
                <field name="reporter_name"/>
                <field name="reporter_email"/>
                <field name="assigned_to"/>
                <separator/>
                <filter name="submitted" string="Submitted"
                        domain="[('status', '=', 'submitted')]"/>
                <filter name="investigating" string="Under Investigation"
                        domain="[('status', '=', 'under_investigation')]"/>
                <filter name="resolved" string="Resolved"
                        domain="[('status', '=', 'resolved')]"/>
                <filter name="closed" string="Closed"
                        domain="[('status', '=', 'closed')]"/>
                <separator/>
                <filter name="anonymous" string="Anonymous"
                        domain="[('is_anonymous', '=', True)]"/>
                <filter name="my_cases" string="My Cases"
                        domain="[('assigned_to', '=', uid)]"/>
            </search>
        </field>
    </record>

    <!-- Whistleblowing — Action -->
    <record id="action_gcg_whistleblowing" model="ir.actions.act_window">
        <field name="name">Whistleblowing</field>
        <field name="res_model">gcg.whistleblowing</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gcg_whistleblowing_search"/>
    </record>

</odoo>
