<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================ -->
    <!--  Authority Matrix — Tree View                                     -->
    <!-- ================================================================ -->
    <record id="view_gcg_authority_matrix_tree" model="ir.ui.view">
        <field name="name">gcg.authority.matrix.tree</field>
        <field name="model">gcg.authority.matrix</field>
        <field name="arch" type="xml">
            <list string="Authority Matrix" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="document_model" optional="show"/>
                <field name="document_type_name" optional="show"/>
                <field name="min_value" optional="show"/>
                <field name="max_value" optional="show"/>
                <field name="approver_role_id" optional="show"/>
                <field name="approver_role_2_id" optional="show"/>
                <field name="is_active" optional="show"/>
                <field name="version"/>
                <field name="approved_date" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Authority Matrix — Form View -->
    <record id="view_gcg_authority_matrix_form" model="ir.ui.view">
        <field name="priority">1</field>
        <field name="name">gcg.authority.matrix.form</field>
        <field name="model">gcg.authority.matrix</field>
        <field name="arch" type="xml">
            <form string="Authority Matrix Entry">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object"
                                class="oe_stat_button" icon="fa-archive"
                                invisible="not is_active">
                            <field name="is_active" widget="boolean_button" options='{"terminology": "active"}'/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="not is_active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. BPB &lt; 5M IDR — Asisten Afdeling"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Scope">
                            <field name="document_model" required="1"/>
                            <field name="document_type_name"/>
                            <field name="sequence"/>
                            <field name="is_active"/>
                        </group>
                        <group string="Value Band">
                            <field name="currency_id" invisible="True"/>
                            <field name="min_value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="max_value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="version"/>
                        </group>
                    </group>
                    <group string="Approval Roles">
                        <field name="approver_role_id" required="1"/>
                        <field name="approver_role_2_id"/>
                    </group>
                    <group string="Version Info" colspan="4">
                        <field name="approved_date"/>
                        <field name="approved_by"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Authority Matrix — Search View -->
    <record id="view_gcg_authority_matrix_search" model="ir.ui.view">
        <field name="name">gcg.authority.matrix.search</field>
        <field name="model">gcg.authority.matrix</field>
        <field name="arch" type="xml">
            <search string="Search Authority Matrix">
                <field name="name"/>
                <field name="document_model"/>
                <field name="document_type_name"/>
                <filter name="active" string="Active" domain="[('is_active', '=', True)]"/>
                <filter name="inactive" string="Archived" domain="[('is_active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Authority Matrix — Action -->
    <record id="action_gcg_authority_matrix" model="ir.actions.act_window">
        <field name="name">Authority Matrix</field>
        <field name="res_model">gcg.authority.matrix</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gcg_authority_matrix_search"/>
    </record>

</odoo>
