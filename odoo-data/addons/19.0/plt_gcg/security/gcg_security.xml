<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================ -->
    <!--  Security Groups                                                  -->
    <!-- ================================================================ -->

    <!-- GCG Admin: full CRUD on all GCG models -->
    <record id="group_gcg_admin" model="res.groups">
        <field name="name">GCG Administrator</field>
        <field name="comment">Full access to all GCG governance, controls, and audit models.</field>
    </record>

    <!-- SPI (Satuan Pengawasan Intern): read-only internal audit role -->
    <record id="group_spi" model="res.groups">
        <field name="name">SPI — Internal Audit</field>
        <field name="comment">Read-only access to all GCG data for internal audit review.</field>
    </record>

    <!-- ================================================================ -->
    <!--  Record Rules — SoD Enforcement                                   -->
    <!-- ================================================================ -->

    <!-- SoD rules are read-only for non-GCG-admin -->
    <record id="rule_sod_readonly" model="ir.rule">
        <field name="name">SoD Rules: Read-only for non-admin</field>
        <field name="model_id" ref="model_gcg_sod_rule"/>
        <field name="groups" eval="[
            (4, ref('base.group_user')),
        ]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Audit log entries are immutable for all -->
    <record id="rule_audit_log_readonly" model="ir.rule">
        <field name="name">Audit Log: Read-only global</field>
        <field name="model_id" ref="model_gcg_audit_log"/>
        <field name="groups" eval="[
            (4, ref('base.group_user')),
        ]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
