<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Budget Actual Tree View ──────────────────────────── -->
    <record id="view_plan_budget_actual_tree" model="ir.ui.view">
        <field name="name">plan.budget_actual.tree</field>
        <field name="model">plan.budget_actual</field>
        <field name="arch" type="xml">
            <list string="Anggaran vs Realisasi">
                <field name="year"/>
                <field name="month"/>
                <field name="block_id"/>
                <field name="activity_code_id"/>
                <field name="budgeted_cost" widget="monetary"/>
                <field name="actual_cost" widget="monetary"/>
                <field name="variance" widget="monetary"
                       decoration-success="variance &gt; 0"
                       decoration-danger="variance &lt; 0"/>
                <field name="variance_pct" widget="percentage"
                       decoration-success="variance &gt; 0"
                       decoration-danger="variance &lt; 0"/>
            </list>
        </field>
    </record>

    <!-- ── Budget Actual Form View ──────────────────────────── -->
    <record id="view_plan_budget_actual_form" model="ir.ui.view">
        <field name="name">plan.budget_actual.form</field>
        <field name="model">plan.budget_actual</field>
        <field name="arch" type="xml">
            <form string="Anggaran vs Realisasi">
                <sheet>
                    <group>
                        <group>
                            <field name="block_id"/>
                            <field name="activity_code_id"/>
                        </group>
                        <group>
                            <field name="year"/>
                            <field name="month"/>
                        </group>
                    </group>
                    <group string="Nilai">
                        <group>
                            <field name="budgeted_cost" widget="monetary"/>
                            <field name="actual_cost" widget="monetary"/>
                        </group>
                        <group>
                            <field name="variance" widget="monetary" readonly="1"
                                   decoration-success="variance &gt; 0"
                                   decoration-danger="variance &lt; 0"/>
                            <field name="variance_pct" widget="percentage" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Keterangan">
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── Budget Actual Search View ────────────────────────── -->
    <record id="view_plan_budget_actual_search" model="ir.ui.view">
        <field name="name">plan.budget_actual.search</field>
        <field name="model">plan.budget_actual</field>
        <field name="arch" type="xml">
            <search string="Anggaran vs Realisasi">
                <field name="block_id"/>
                <field name="activity_code_id"/>
                <field name="year"/>
                <separator/>
                <filter name="filter_over_budget" string="Over Budget"
                        domain="[('variance', '&lt;', 0)]"/>
                <filter name="filter_under_budget" string="Under Budget"
                        domain="[('variance', '&gt;', 0)]"/>
            </search>
        </field>
    </record>

</odoo>