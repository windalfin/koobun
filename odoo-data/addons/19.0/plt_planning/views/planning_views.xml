<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Norma Kerja ─────────────────────────────────────── -->
    <record id="view_plan_norma_kerja_tree" model="ir.ui.view">
        <field name="name">plan.norma_kerja.tree</field>
        <field name="model">plan.norma_kerja</field>
        <field name="arch" type="xml">
            <list string="Norma Kerja">
                <field name="activity_code_id"/>
                <field name="output_per_hk"/>
                <field name="output_uom"/>
                <field name="cost_per_unit"/>
                <field name="effective_from"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_plan_norma_kerja_form" model="ir.ui.view">
        <field name="priority">1</field>
        <field name="name">plan.norma_kerja.form</field>
        <field name="model">plan.norma_kerja</field>
        <field name="arch" type="xml">
            <form string="Norma Kerja">
                <sheet>
                    <group>
                        <group>
                            <field name="activity_code_id"/>
                            <field name="output_per_hk"/>
                            <field name="output_uom"/>
                        </group>
                        <group>
                            <field name="cost_per_unit"/>
                            <field name="effective_from"/>
                            <field name="effective_to"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── RKAP ────────────────────────────────────────────── -->
    <record id="view_plan_rkap_tree" model="ir.ui.view">
        <field name="name">plan.rkap.tree</field>
        <field name="model">plan.rkap</field>
        <field name="arch" type="xml">
            <list string="RKAP">
                <field name="year"/>
                <field name="month"/>
                <field name="block_id"/>
                <field name="activity_code_id"/>
                <field name="physical_qty"/>
                <field name="total_cost"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_plan_rkap_form" model="ir.ui.view">
        <field name="priority">1</field>
        <field name="name">plan.rkap.form</field>
        <field name="model">plan.rkap</field>
        <field name="arch" type="xml">
            <form string="RKAP">
                <header>
                    <button name="action_propose" type="object" string="Propose"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'proposed'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('approved', 'cancelled')"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,proposed,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="year"/>
                            <field name="month"/>
                            <field name="block_id"/>
                            <field name="activity_code_id"/>
                        </group>
                        <group>
                            <field name="physical_qty"/>
                            <field name="physical_uom"/>
                            <field name="hk_planned"/>
                            <field name="version"/>
                        </group>
                    </group>
                    <group string="Costs">
                        <group>
                            <field name="material_cost"/>
                        </group>
                        <group>
                            <field name="labor_cost"/>
                            <field name="total_cost"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── RKB ─────────────────────────────────────────────── -->
    <record id="view_plan_rkb_tree" model="ir.ui.view">
        <field name="name">plan.rkb.tree</field>
        <field name="model">plan.rkb</field>
        <field name="arch" type="xml">
            <list string="RKB">
                <field name="year"/>
                <field name="month"/>
                <field name="block_id"/>
                <field name="activity_code_id"/>
                <field name="physical_qty"/>
                <field name="deviation_pct" widget="percentage"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_plan_rkb_form" model="ir.ui.view">
        <field name="priority">1</field>
        <field name="name">plan.rkb.form</field>
        <field name="model">plan.rkb</field>
        <field name="arch" type="xml">
            <form string="RKB">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="year"/>
                            <field name="month"/>
                            <field name="block_id"/>
                            <field name="activity_code_id"/>
                        </group>
                        <group>
                            <field name="physical_qty"/>
                            <field name="hk_planned"/>
                            <field name="deviation_pct" widget="percentage"/>
                        </group>
                    </group>
                    <group string="Deviation Justification">
                        <field name="deviation_justification"/>
                    </group>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── RKH ─────────────────────────────────────────────── -->
    <record id="view_plan_rkh_tree" model="ir.ui.view">
        <field name="name">plan.rkh.tree</field>
        <field name="model">plan.rkh</field>
        <field name="arch" type="xml">
            <list string="RKH">
                <field name="date"/>
                <field name="mandor_id"/>
                <field name="block_id"/>
                <field name="activity_code_id"/>
                <field name="target_qty"/>
                <field name="worker_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_plan_rkh_form" model="ir.ui.view">
        <field name="priority">1</field>
        <field name="name">plan.rkh.form</field>
        <field name="model">plan.rkh</field>
        <field name="arch" type="xml">
            <form string="RKH">
                <header>
                    <button name="action_issue" type="object" string="Issue"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_complete" type="object" string="Complete"
                            class="btn-primary" invisible="state != 'issued'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,issued,completed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="mandor_id"/>
                            <field name="block_id"/>
                            <field name="activity_code_id"/>
                        </group>
                        <group>
                            <field name="target_qty"/>
                            <field name="target_uom"/>
                            <field name="worker_count"/>
                            <field name="worker_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Materials">
                        <field name="planned_materials"/>
                    </group>
                    <group string="BKM">
                        <field name="bkm_ids">
                            <list string="BKM Records">
                                <field name="date"/>
                                <field name="state"/>
                                <field name="worker_count"/>
                            </list>
                        </field>
                    </group>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

</odoo>
