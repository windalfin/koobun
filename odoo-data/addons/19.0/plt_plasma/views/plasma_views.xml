<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Farmer Tree -->
    <record id="view_plasma_farmer_tree" model="ir.ui.view">
        <field name="name">plasma.farmer.tree</field>
        <field name="model">plasma.farmer</field>
        <field name="arch" type="xml">
            <list string="Farmers">
                <field name="name"/>
                <field name="nik"/>
                <field name="stdb"/>
                <field name="koperasi_id"/>
                <field name="land_area_ha"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Farmer Form -->
    <record id="view_plasma_farmer_form" model="ir.ui.view">
        <field name="priority">1</field>
        <field name="name">plasma.farmer.form</field>
        <field name="model">plasma.farmer</field>
        <field name="arch" type="xml">
            <form string="Farmer">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="nik"/>
                            <field name="stdb"/>
                            <field name="join_date"/>
                        </group>
                        <group>
                            <field name="land_area_ha"/>
                            <field name="koperasi_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Bank">
                        <group><field name="bank_account"/></group>
                        <group><field name="bank_name"/></group>
                    </group>
                    <group string="GIS"><field name="plot_geojson"/></group>
                    <group string="Notes"><field name="notes"/></group>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>

    <!-- Koperasi Tree -->
    <record id="view_plasma_koperasi_tree" model="ir.ui.view">
        <field name="name">plasma.koperasi.tree</field>
        <field name="model">plasma.koperasi</field>
        <field name="arch" type="xml">
            <list string="Koperasi">
                <field name="code"/>
                <field name="name"/>
                <field name="contact_person"/>
                <field name="farmer_count"/>
            </list>
        </field>
    </record>

    <!-- FFB Intake Tree -->
    <record id="view_plasma_ffb_intake_tree" model="ir.ui.view">
        <field name="name">plasma.ffb_intake.tree</field>
        <field name="model">plasma.ffb_intake</field>
        <field name="arch" type="xml">
            <list string="FFB Intake">
                <field name="date"/>
                <field name="farmer_id"/>
                <field name="net_kg"/>
                <field name="price_per_kg"/>
                <field name="gross_amount"/>
                <field name="net_amount"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- FFB Intake Form -->
    <record id="view_plasma_ffb_intake_form" model="ir.ui.view">
        <field name="priority">1</field>
        <field name="name">plasma.ffb_intake.form</field>
        <field name="model">plasma.ffb_intake</field>
        <field name="arch" type="xml">
            <form string="FFB Intake">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="farmer_id"/>
                            <field name="spb_id"/>
                        </group>
                        <group>
                            <field name="net_kg"/>
                            <field name="disbun_price_id"/>
                            <field name="price_per_kg"/>
                        </group>
                    </group>
                    <group string="Financial">
                        <group><field name="gross_amount"/></group>
                        <group><field name="deduction_pct"/><field name="net_amount"/></group>
                    </group>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>

    <!-- Loan Ledger Tree -->
    <record id="view_plasma_loan_ledger_tree" model="ir.ui.view">
        <field name="name">plasma.loan_ledger.tree</field>
        <field name="model">plasma.loan_ledger</field>
        <field name="arch" type="xml">
            <list string="Loan Ledger">
                <field name="date"/>
                <field name="farmer_id"/>
                <field name="description"/>
                <field name="amount"/>
                <field name="remaining_balance"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Farmer Statement Tree -->
    <record id="view_plasma_farmer_statement_tree" model="ir.ui.view">
        <field name="name">plasma.farmer_statement.tree</field>
        <field name="model">plasma.farmer_statement</field>
        <field name="arch" type="xml">
            <list string="Farmer Statements">
                <field name="year"/>
                <field name="month"/>
                <field name="farmer_id"/>
                <field name="total_delivery_kg"/>
                <field name="gross_revenue"/>
                <field name="net_payment"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Farmer Statement Form -->
    <record id="view_plasma_farmer_statement_form" model="ir.ui.view">
        <field name="priority">1</field>
        <field name="name">plasma.farmer_statement.form</field>
        <field name="model">plasma.farmer_statement</field>
        <field name="arch" type="xml">
            <form string="Farmer Statement">
                <header>
                    <button name="action_post" type="object" string="Post"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="year"/>
                            <field name="month"/>
                            <field name="farmer_id"/>
                        </group>
                        <group>
                            <field name="total_delivery_kg"/>
                            <field name="gross_revenue"/>
                            <field name="total_deductions"/>
                            <field name="net_payment"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>

    <record id="view_plasma_siperibun_report_form" model="ir.ui.view">
        <field name="priority">1</field>
        <field name="name">plasma.siperibun_report.form</field>
        <field name="model">plasma.siperibun_report</field>
        <field name="arch" type="xml">
            <form string="Laporan SIPERIBUN">
                <sheet>
                    <group>
                        <group string="Periode">
                            <field name="period_start"/>
                            <field name="period_end"/>
                        </group>
                        <group string="Rekapitulasi">
                            <field name="total_farmers"/>
                            <field name="total_delivery_kg"/>
                            <field name="total_payment"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Catatan">
                        <field name="notes" placeholder="Catatan laporan..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>


    <!-- ── Koperasi Form View ─────────────────────────── -->
    <record id="view_plasma_koperasi_form" model="ir.ui.view">
        <field name="priority">1</field>
        <field name="name">plasma.koperasi.form</field>
        <field name="model">plasma.koperasi</field>
        <field name="arch" type="xml">
            <form string="Koperasi">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="contact_person"/>
                            <field name="phone"/>
                            <field name="farmer_count"/>
                        </group>
                    </group>
                    <group string="Alamat">
                        <field name="address"/>
                    </group>
                    <notebook>
                        <page string="Petani">
                            <field name="farmer_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="nik"/>
                                    <field name="stdb"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>

    <!-- ── Loan Ledger Form View ─────────────────────────── -->
    <record id="view_plasma_loan_ledger_form" model="ir.ui.view">
        <field name="priority">1</field>
        <field name="name">plasma.loan_ledger.form</field>
        <field name="model">plasma.loan_ledger</field>
        <field name="arch" type="xml">
            <form string="Loan Ledger">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="active,settled,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="farmer_id"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="deduction_pct"/>
                            <field name="remaining_balance"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <group string="Catatan">
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>
</odoo>
