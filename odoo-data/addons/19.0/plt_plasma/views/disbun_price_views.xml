<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Disbun Price Tree View ───────────────────────────── -->
    <record id="view_plasma_disbun_price_tree" model="ir.ui.view">
        <field name="name">plasma.disbun_price.tree</field>
        <field name="model">plasma.disbun_price</field>
        <field name="arch" type="xml">
            <list string="Harga Disbun">
                <field name="name"/>
                <field name="age_band_min"/>
                <field name="age_band_max"/>
                <field name="price_per_kg" widget="monetary"/>
                <field name="effective_from"/>
                <field name="effective_to"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <!-- ── Disbun Price Form View ───────────────────────────── -->
    <record id="view_plasma_disbun_price_form" model="ir.ui.view">
        <field name="name">plasma.disbun_price.form</field>
        <field name="model">plasma.disbun_price</field>
        <field name="arch" type="xml">
            <form string="Harga Disbun">
                <header>
                    <button name="action_approve" type="object"
                            string="Setujui"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_set_draft" type="object"
                            string="Kembali ke Draft"
                            invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="age_band_min"/>
                            <field name="age_band_max"/>
                            <field name="price_per_kg"/>
                        </group>
                        <group>
                            <field name="effective_from"/>
                            <field name="effective_to"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── Disbun Price Search View ─────────────────────────── -->
    <record id="view_plasma_disbun_price_search" model="ir.ui.view">
        <field name="name">plasma.disbun_price.search</field>
        <field name="model">plasma.disbun_price</field>
        <field name="arch" type="xml">
            <search string="Harga Disbun">
                <field name="name"/>
                <separator/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_approved" string="Disetujui"
                        domain="[('state', '=', 'approved')]"/>
            </search>
        </field>
    </record>

    </odoo>