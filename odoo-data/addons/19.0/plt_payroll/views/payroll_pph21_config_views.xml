<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── PPh 21 Config Tree View ────────────────────────── -->
    <record id="view_payroll_pph21_config_tree" model="ir.ui.view">
        <field name="name">payroll.pph21_config.tree</field>
        <field name="model">payroll.pph21_config</field>
        <field name="arch" type="xml">
            <list string="PPh 21 TER Tables">
                <field name="ptkp_category"/>
                <field name="ter_category"/>
                <field name="rate_pct"/>
                <field name="effective_from"/>
                <field name="effective_to"/>
            </list>
        </field>
    </record>

    <!-- ── PPh 21 Config Form View ────────────────────────── -->
    <record id="view_payroll_pph21_config_form" model="ir.ui.view">
        <field name="priority">1</field>
        <field name="name">payroll.pph21_config.form</field>
        <field name="model">payroll.pph21_config</field>
        <field name="arch" type="xml">
            <form string="PPh 21 Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="ptkp_category"/>
                            <field name="ter_category"/>
                        </group>
                        <group>
                            <field name="rate_pct" widget="percentage"/>
                        </group>
                    </group>
                    <group string="Effective Period">
                        <group>
                            <field name="effective_from"/>
                            <field name="effective_to"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── PPh 21 Config Action ───────────────────────────── -->
    <record id="action_payroll_pph21_config" model="ir.actions.act_window">
        <field name="name">PPh 21 TER Tables</field>
        <field name="res_model">payroll.pph21_config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
