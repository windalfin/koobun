<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── PTKP Table Tree View ─────────────────────────────── -->
    <record id="view_payroll_ptkp_table_tree" model="ir.ui.view">
        <field name="name">payroll.ptkp_table.tree</field>
        <field name="model">payroll.ptkp_table</field>
        <field name="arch" type="xml">
            <list string="Tabel PTKP">
                <field name="code"/>
                <field name="name"/>
                <field name="amount" widget="monetary"/>
                <field name="effective_from"/>
                <field name="effective_to"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <!-- ── PTKP Table Form View ─────────────────────────────── -->
    <record id="view_payroll_ptkp_table_form" model="ir.ui.view">
        <field name="name">payroll.ptkp_table.form</field>
        <field name="model">payroll.ptkp_table</field>
        <field name="arch" type="xml">
            <form string="Tabel PTKP">
                <header>
                    <button name="action_approve" type="object"
                            string="Setujui"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_set_draft" type="object"
                            string="Kembali ke Draft"
                            invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="effective_from"/>
                            <field name="effective_to"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── PTKP Table Search View ───────────────────────────── -->
    <record id="view_payroll_ptkp_table_search" model="ir.ui.view">
        <field name="name">payroll.ptkp_table.search</field>
        <field name="model">payroll.ptkp_table</field>
        <field name="arch" type="xml">
            <search string="Tabel PTKP">
                <field name="code"/>
                <field name="name"/>
                <separator/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_approved" string="Disetujui"
                        domain="[('state', '=', 'approved')]"/>
            </search>
        </field>
    </record>

    <!-- ── PTKP Table Action ────────────────────────────────── -->
    <record id="action_payroll_ptkp_table" model="ir.actions.act_window">
        <field name="name">Tabel PTKP</field>
        <field name="res_model">payroll.ptkp_table</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>