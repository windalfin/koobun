<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Worker Contract Tree View ──────────────────────── -->
    <record id="view_payroll_worker_contract_tree" model="ir.ui.view">
        <field name="name">payroll.worker_contract.tree</field>
        <field name="model">payroll.worker_contract</field>
        <field name="arch" type="xml">
            <list string="Worker Contracts">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="worker_class"/>
                <field name="contract_type"/>
                <field name="wage_master_id"/>
                <field name="bpjs_applicable"/>
                <field name="pph21_applicable"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- ── Worker Contract Form View ──────────────────────── -->
    <record id="view_payroll_worker_contract_form" model="ir.ui.view">
        <field name="priority">99</field>
        <field name="name">payroll.worker_contract.form</field>
        <field name="model">payroll.worker_contract</field>
        <field name="arch" type="xml">
            <form string="Worker Contract">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="job_id"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="worker_class"/>
                            <field name="contract_type"/>
                            <field name="wage_master_id"/>
                            <field name="wage" string="Monthly Wage"/>
                        </group>
                    </group>
                    <group string="Social Security">
                        <group>
                            <field name="bpjs_applicable"/>
                        </group>
                        <group>
                            <field name="pph21_applicable"/>
                        </group>
                    </group>
                    <group string="Dates">
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── Worker Contract Action ─────────────────────────── -->
    <record id="action_payroll_worker_contract" model="ir.actions.act_window">
        <field name="name">Worker Contracts</field>
        <field name="res_model">payroll.worker_contract</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
