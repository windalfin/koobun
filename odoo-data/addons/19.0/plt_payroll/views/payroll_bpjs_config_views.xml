<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── BPJS Config Tree View ──────────────────────────── -->
    <record id="view_payroll_bpjs_config_tree" model="ir.ui.view">
        <field name="name">payroll.bpjs_config.tree</field>
        <field name="model">payroll.bpjs_config</field>
        <field name="arch" type="xml">
            <list string="BPJS Configurations">
                <field name="name"/>
                <field name="bpjs_type"/>
                <field name="employer_pct"/>
                <field name="employee_pct"/>
                <field name="ceiling_amount"/>
                <field name="effective_from"/>
                <field name="effective_to"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <!-- ── BPJS Config Form View ──────────────────────────── -->
    <record id="view_payroll_bpjs_config_form" model="ir.ui.view">
        <field name="priority">99</field>
        <field name="name">payroll.bpjs_config.form</field>
        <field name="model">payroll.bpjs_config</field>
        <field name="arch" type="xml">
            <form string="BPJS Configuration">
                <header>
                    <button name="action_approve" type="object"
                            string="Approve"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_set_draft" type="object"
                            string="Set Draft"
                            invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="bpjs_type"/>
                            <field name="risk_class"
                                   invisible="bpjs_type != 'JKK'"/>
                        </group>
                        <group>
                            <field name="effective_from"/>
                            <field name="effective_to"/>
                        </group>
                    </group>
                    <group string="Contribution Rates">
                        <group>
                            <field name="employer_pct" widget="percentage"/>
                            <field name="employee_pct" widget="percentage"/>
                        </group>
                        <group>
                            <field name="ceiling_amount"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── BPJS Config Action ─────────────────────────────── -->
    <record id="action_payroll_bpjs_config" model="ir.actions.act_window">
        <field name="name">BPJS Configurations</field>
        <field name="res_model">payroll.bpjs_config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
