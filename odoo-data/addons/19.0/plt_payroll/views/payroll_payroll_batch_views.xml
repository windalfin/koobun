<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Payroll Batch Tree View ────────────────────────── -->
    <record id="view_payroll_payroll_batch_tree" model="ir.ui.view">
        <field name="name">payroll.payroll_batch.tree</field>
        <field name="model">payroll.payroll_batch</field>
        <field name="arch" type="xml">
            <list string="Payroll Batches"
                  decoration-success="state == 'posted'"
                  decoration-warning="state in ('calculated', 'verified')">
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="afdeling_id"/>
                <field name="total_gross" sum="Total Gross"/>
                <field name="total_deductions" sum="Total Deductions"/>
                <field name="total_net" sum="Net Pay"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'posted'"
                       decoration-warning="state == 'verified'"
                       decoration-info="state == 'calculated'"/>
            </list>
        </field>
    </record>

    <!-- ── Payroll Batch Form View ────────────────────────── -->
    <record id="view_payroll_payroll_batch_form" model="ir.ui.view">
        <field name="priority">1</field>
        <field name="name">payroll.payroll_batch.form</field>
        <field name="model">payroll.payroll_batch</field>
        <field name="arch" type="xml">
            <form string="Payroll Batch">
                <header>
                    <button name="action_calculate" type="object"
                            string="Calculate"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_verify" type="object"
                            string="Verify"
                            invisible="state != 'calculated'"/>
                    <button name="action_approve" type="object"
                            string="Approve"
                            invisible="state != 'verified'"/>
                    <button name="action_post" type="object"
                            string="Post"
                            class="oe_highlight"
                            invisible="state != 'approved'"/>
                    <button name="action_set_draft" type="object"
                            string="Set Draft"
                            invisible="state == 'draft' or state == 'posted'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,calculated,verified,approved,posted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="period_start"/>
                            <field name="period_end"/>
                        </group>
                        <group>
                            <field name="afdeling_id"/>
                        </group>
                    </group>
                    <group string="Totals">
                        <group>
                            <field name="total_gross"/>
                            <field name="total_deductions"/>
                            <field name="total_net"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Workers">
                            <field name="worker_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Payslip Lines">
                            <field name="payslip_line_ids">
                                <list editable="bottom">
                                    <field name="employee_id"/>
                                    <field name="hk_count"/>
                                    <field name="daily_base"/>
                                    <field name="premi_amount"/>
                                    <field name="denda_amount"/>
                                    <field name="pph21_amount"/>
                                    <field name="tht_amount"/>
                                    <field name="net_pay"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── Payroll Batch Action ───────────────────────────── -->
    <record id="action_payroll_payroll_batch" model="ir.actions.act_window">
        <field name="name">Payroll Batches</field>
        <field name="res_model">payroll.payroll_batch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
