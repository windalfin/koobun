<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="menu_nursery_root" name="Nursery (Pembibitan)" sequence="20"/>

    <record id="action_nursery_batch" model="ir.actions.act_window">
        <field name="name">Nursery Batches</field>
        <field name="res_model">nursery.batch</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_nursery_batch" parent="menu_nursery_root" name="Batches"
              sequence="10" action="action_nursery_batch"/>

    <record id="action_nursery_culling" model="ir.actions.act_window">
        <field name="name">Culling Records</field>
        <field name="res_model">nursery.culling</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_nursery_culling" parent="menu_nursery_root" name="Cullings"
              sequence="20" action="action_nursery_culling"/>

    <record id="action_nursery_transfer" model="ir.actions.act_window">
        <field name="name">Transfers</field>
        <field name="res_model">nursery.transfer</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_nursery_transfer" parent="menu_nursery_root" name="Transfers"
              sequence="30" action="action_nursery_transfer"/>

</odoo>
