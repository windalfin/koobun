<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── SPB List View ───────────────────────────────────── -->
    <record id="view_transport_spb_list" model="ir.ui.view">
        <field name="name">transport.spb.list</field>
        <field name="model">transport.spb</field>
        <field name="arch" type="xml">
            <list string="SPB" decoration-info="state == 'draft'"
                  decoration-warning="state in ('issued', 'weighed')"
                  decoration-success="state in ('delivered', 'mill_confirmed', 'closed')">
                <field name="number"/>
                <field name="date"/>
                <field name="truck_id"/>
                <field name="driver_id"/>
                <field name="janjang_count"/>
                <field name="estimated_kg"/>
                <field name="weight_net"/>
                <field name="destination_mill_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('issued', 'weighed')"
                       decoration-success="state in ('delivered', 'mill_confirmed', 'closed')"/>
            </list>
        </field>
    </record>

    <!-- ── SPB Form View ───────────────────────────────────── -->
    <record id="view_transport_spb_form" model="ir.ui.view">
        <field name="name">transport.spb.form</field>
        <field name="model">transport.spb</field>
        <field name="arch" type="xml">
            <form string="SPB">
                <header>
                    <button name="action_issue" type="object"
                            string="Issue" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_weigh" type="object"
                            string="Weigh" class="oe_highlight"
                            invisible="state != 'issued'"/>
                    <button name="action_deliver" type="object"
                            string="Deliver" class="oe_highlight"
                            invisible="state != 'weighed'"/>
                    <button name="action_mill_confirm" type="object"
                            string="Mill Confirm" class="oe_highlight"
                            invisible="state != 'delivered'"/>
                    <button name="action_close" type="object"
                            string="Close"
                            invisible="state not in ('mill_confirmed', 'delivered')"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,issued,weighed,delivered,mill_confirmed,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="number"/>
                            <field name="date"/>
                            <field name="seal_number"/>
                        </group>
                        <group>
                            <field name="truck_id"/>
                            <field name="driver_id"/>
                            <field name="destination_mill_id"/>
                        </group>
                    </group>
                    <group string="Cargo">
                        <group>
                            <field name="janjang_count"/>
                            <field name="estimated_kg"/>
                        </group>
                        <group>
                            <field name="weight_net" widget="monetary"/>
                        </group>
                    </group>
                    <group string="Source">
                        <field name="block_ids" widget="many2many_tags"/>
                        <field name="tph_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Weighbridge Tickets">
                            <field name="weighbridge_ticket_ids">
                                <list editable="bottom">
                                    <field name="timestamp"/>
                                    <field name="gross_kg"/>
                                    <field name="tare_kg"/>
                                    <field name="net_kg"/>
                                    <field name="mode" widget="badge"/>
                                    <field name="manual_approved"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reconciliation">
                            <field name="reconciliation_ids">
                                <list>
                                    <field name="spb_janjang"/>
                                    <field name="spb_est_kg"/>
                                    <field name="weighbridge_net"/>
                                    <field name="mill_net"/>
                                    <field name="variance_pct" widget="percentage"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── SPB Search View ─────────────────────────────────── -->
    <record id="view_transport_spb_search" model="ir.ui.view">
        <field name="name">transport.spb.search</field>
        <field name="model">transport.spb</field>
        <field name="arch" type="xml">
            <search string="Search SPB">
                <field name="number"/>
                <field name="truck_id"/>
                <field name="driver_id"/>
                <field name="destination_mill_id"/>
                <filter name="draft" string="Draft"
                        domain="[('state','=','draft')]"/>
                <filter name="issued" string="Issued"
                        domain="[('state','=','issued')]"/>
                <filter name="weighed" string="Weighed"
                        domain="[('state','=','weighed')]"/>
                <filter name="delivered" string="Delivered"
                        domain="[('state','=','delivered')]"/>
                <filter name="mill_confirmed" string="Mill Confirmed"
                        domain="[('state','=','mill_confirmed')]"/>
                <filter name="closed" string="Closed"
                        domain="[('state','=','closed')]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('date','=',context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="group_state" string="Status"
                        context="{'group_by':'state'}"/>
                <filter name="group_date" string="Date"
                        context="{'group_by':'date'}"/>
                <filter name="group_truck" string="Truck"
                        context="{'group_by':'truck_id'}"/>
            </search>
        </field>
    </record>

    <!-- ── SPB Action ──────────────────────────────────────── -->
    <record id="action_transport_spb" model="ir.actions.act_window">
        <field name="name">SPB (Surat Pengantar Buah)</field>
        <field name="res_model">transport.spb</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first SPB!
            </p>
        </field>
    </record>
</odoo>
