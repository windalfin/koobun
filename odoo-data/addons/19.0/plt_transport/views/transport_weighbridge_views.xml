<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Weighbridge Ticket List View ────────────────────── -->
    <record id="view_transport_weighbridge_ticket_list" model="ir.ui.view">
        <field name="name">transport.weighbridge_ticket.list</field>
        <field name="model">transport.weighbridge_ticket</field>
        <field name="arch" type="xml">
            <list string="Weighbridge Tickets"
                  decoration-warning="mode == 'manual' and not manual_approved">
                <field name="spb_id"/>
                <field name="timestamp"/>
                <field name="gross_kg"/>
                <field name="tare_kg"/>
                <field name="net_kg"/>
                <field name="mode" widget="badge"/>
                <field name="manual_approved"/>
                <field name="operator_id"/>
            </list>
        </field>
    </record>

    <!-- ── Weighbridge Ticket Form View ────────────────────── -->
    <record id="view_transport_weighbridge_ticket_form" model="ir.ui.view">
        <field name="name">transport.weighbridge_ticket.form</field>
        <field name="model">transport.weighbridge_ticket</field>
        <field name="arch" type="xml">
            <form string="Weighbridge Ticket">
                <header>
                    <button name="action_approve_manual" type="object"
                            string="Approve Manual"
                            class="oe_highlight"
                            invisible="mode != 'manual' or manual_approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="spb_id"/>
                            <field name="timestamp"/>
                            <field name="operator_id"/>
                        </group>
                        <group>
                            <field name="mode"/>
                            <field name="manual_approved"
                                   invisible="mode != 'manual'"/>
                            <field name="approved_by"
                                   invisible="mode != 'manual'"/>
                        </group>
                    </group>
                    <group string="Weights">
                        <group>
                            <field name="gross_kg"/>
                            <field name="tare_kg"/>
                        </group>
                        <group>
                            <field name="net_kg" widget="monetary"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── Weighbridge Ticket Search View ──────────────────── -->
    <record id="view_transport_weighbridge_ticket_search" model="ir.ui.view">
        <field name="name">transport.weighbridge_ticket.search</field>
        <field name="model">transport.weighbridge_ticket</field>
        <field name="arch" type="xml">
            <search string="Search Weighbridge Tickets">
                <field name="spb_id"/>
                <field name="operator_id"/>
                <filter name="auto_mode" string="Auto"
                        domain="[('mode','=','auto')]"/>
                <filter name="manual_mode" string="Manual"
                        domain="[('mode','=','manual')]"/>
                <filter name="unapproved_manual" string="Unapproved Manual"
                        domain="[('mode','=','manual'),('manual_approved','=',False)]"/>
                <separator/>
                <filter name="group_mode" string="Mode"
                        context="{'group_by':'mode'}"/>
                <filter name="group_spb" string="SPB"
                        context="{'group_by':'spb_id'}"/>
            </search>
        </field>
    </record>

    <!-- ── Weighbridge Ticket Action ───────────────────────── -->
    <record id="action_transport_weighbridge_ticket" model="ir.actions.act_window">
        <field name="name">Weighbridge Tickets</field>
        <field name="res_model">transport.weighbridge_ticket</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
